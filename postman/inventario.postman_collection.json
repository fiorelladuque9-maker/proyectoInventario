      "name": "1. Autenticación",
      "description": "Obtenga primero los tres tokens; el administrador queda como perfil activo.",
      "item": [
        {
          "name": "Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });",
                  "const t = pm.response.json().token;",
                  "pm.test(\"Devuelve un token\", function () { pm.expect(t).to.be.a(\"string\").and.not.empty; });",
                  "pm.collectionVariables.set(\"token_admin\", t);",
                  "pm.collectionVariables.set(\"token\", t);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                ""
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{usuario_admin}}\",\n  \"password\": \"{{clave_admin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Obtiene el token del perfil. Guarda token_admin y lo deja como token activo.",
            "auth": {
              "type": "noauth"
            }
